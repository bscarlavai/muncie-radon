---
import { site, areaListSentence } from '../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import PhoneLink from '../components/PhoneLink.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Callout from '../components/Callout.astro';
import { Icon } from 'astro-icon/components';

// Both of these are length-constrained on purpose. The old title rendered at
// 623px against Google's ~580px cut, which truncated "from $1,200" away: the
// price is the differentiator, so losing it to an ellipsis was the expensive
// part. Dropping "Certified Testing" also settles a house-rule problem, since a
// title reading "Certified" next to our own brand implies we hold the
// certification when it belongs to the installer.
// The description ran 165 chars against a ~155 practical cut. Price is gone from
// it because the title now carries it, and repeating it inside one SERP result
// buys nothing.
const title = `Radon Mitigation Muncie IN | Systems from $1,200`;
// Leads with "Radon testing and mitigation" because the previous version named
// neither. Both terms were in the title and the H2s but missing from the
// description, so the snippet Google shows carried no bolded query match on the
// two words people actually type.
const description = `Radon testing and mitigation in Muncie, IN. Delaware County is EPA Zone 1 and the average home tests at the action level. Free estimates, honest pricing.`;

const steps = [
  {
    title: 'Tell us your number, or that you do not have one',
    body: `Call or send the form. If an inspector already handed you a result, that report is enough to start from. If you have never tested, that is the first thing to sort out and it is the cheapest step by far.`,
  },
  {
    title: 'We route you to a certified professional',
    body: `${site.state} requires ${site.localFacts.certifier} certification to perform radon testing and mitigation. We connect you with someone who holds it and works in ${site.county}, rather than a national dispatch queue.`,
  },
  {
    title: 'On-site assessment and a written quote',
    body: `Foundation type, slab construction, sump setup, and the shortest legal route above the roofline all move the price. Those get looked at in person before a number gets written down. Ask for that number in writing before any work starts.`,
  },
  {
    title: 'Install, then a post-mitigation test',
    body: `Most single-family systems are a one-day job. The step people skip is the one that matters most: a post-mitigation test documenting the new level. Keep that document, because it is what a future buyer's agent will ask to see.`,
  },
];

const faqs = [
  {
    q: 'How much does a radon mitigation system cost in Indiana?',
    a: `<p>Most single-family systems in the ${site.city} area run <strong>$1,200 to $2,000 installed</strong>. Indiana's state fact sheet cites an $800&ndash;$1,200 average, which reflects the simplest possible slab job. Real quotes in ${site.county} land higher once you account for foundation type, how far the pipe has to travel to get above the roofline, and whether the crawl space needs a membrane.</p><p>We publish the range because hiding it wastes your time and ours. See the full breakdown on our <a href="/services/radon-mitigation/">radon mitigation page</a>.</p>`,
  },
  {
    q: 'Is 3.3 pCi/L worth mitigating?',
    a: `<p>Honestly: it's a judgment call, and anyone who tells you otherwise is selling. EPA's action level is 4.0 pCi/L and they suggest <em>considering</em> mitigation between 2.0 and 4.0. There's no threshold below which radon is proven harmless, but the risk curve at 3.3 is meaningfully flatter than at 8.</p><p>Two things push a 3.3 toward "fix it": you have a finished basement someone sleeps or works in, or you tested in summer. Closed-house winter conditions in ${site.city} commonly produce higher readings than the same home tested in July.</p>`,
  },
  {
    q: 'How long does a radon system take to install?',
    a: `<p>Most ${site.city} homes are a single day. The crew cores the slab, runs sealed PVC to an exterior fan and up past the roofline, seals the sump pit and any open floor penetrations, and mounts a manometer so you can see the system working. Crawl space membrane work and homes needing multiple suction points can extend into a second day.</p>`,
  },
  {
    q: 'Will a radon system hurt my chances of selling my house?',
    a: `<p>The opposite, in practice. An unmitigated home with a high test result is a negotiation problem discovered two weeks before closing. A home with a documented system and a post-install retest under 2.0 is a solved problem, and buyers' agents in ${site.county} see enough radon addenda that they recognize it as one.</p><p>More on the transaction side on our <a href="/services/real-estate-radon/">real estate radon page</a>.</p>`,
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{site.county} · {site.state}</span>
        <h1>Radon Mitigation in {site.city}, {site.state}</h1>
        <p class="lead">
          {site.county} is <strong>EPA Zone 1</strong>, the highest radon risk designation in the
          country. The average {site.city} home tests at <strong
            >{site.localFacts.avgLevel} pCi/L</strong
          >, which is exactly the level at which the EPA says to fix it.
        </p>
        <p class="hero-sub">
          Free estimates, a published price range, and systems installed by {
            site.localFacts.certifier
          }-certified professionals. Find out where your house actually stands.
        </p>

        <div class="hero-actions">
          <PhoneLink placement="hero" variant="button" />
          <a href="#quote" class="btn btn-secondary">Get a free quote</a>
        </div>

        <ul class="trust-row">
          <li>
            <Icon name="lucide:banknote" size={18} /><span>{site.priceRange} typical install</span>
          </li>
          <li>
            <Icon name="lucide:shield-check" size={18} /><span>
              {site.localFacts.certifier}-certified professionals
            </span>
          </li>
          <li><Icon name="lucide:check" size={18} /><span>Free estimates</span></li>
        </ul>
      </div>

      <div class="hero-form">
        <QuoteForm
          formId="home:hero"
          heading="What's your radon number?"
          subheading="Tell us a little about the house, and we'll come back with a real estimate rather than a range designed to get us in the door."
        />
      </div>
    </div>
  </section>

  <!-- 1. SERVICES -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">What we do</span>
      <h2 class="mt-0">Radon services in {site.city}</h2>
      <p class="section-intro">
        Six services cover essentially every radon situation a {site.county} property owner runs
        into, from a homeowner who just wants to know their number, to an agent whose closing is
        eleven days out, to a landlord with a twelve-unit building.
      </p>
      <ServiceGrid />
    </div>
  </section>

  <!-- 2. WHY MUNCIE -->
  <section class="section section-alt">
    <div class="wrap two-col">
      <div>
        <span class="eyebrow">The local problem</span>
        <h2 class="mt-0">Why {site.city} homes have a radon problem</h2>
        <p>
          Radon is a radioactive gas produced by uranium decaying in soil and rock. It seeps up
          through foundation cracks, sump pits, crawl space floors, and plumbing penetrations, then
          accumulates indoors because your house is, from the gas's point of view, a chimney. It is
          colorless, odorless, and tasteless. The only way to know your level is to measure it.
        </p>
        <p>
          {site.county} is designated <strong>EPA Zone 1</strong>, the agency's highest-risk
          category, meaning the predicted average indoor screening level for the county exceeds 4.0
          pCi/L. Measured reality matches the prediction: the average {site.city} indoor reading is
          about {site.localFacts.avgLevel} pCi/L. That average is the important number, because it
          means a coin flip on whether any given house here is over the action level.
        </p>
        <p>Three local factors stack on top of the geology:</p>
        <ul>
          <li>
            <strong>Glacial till.</strong> The unconsolidated deposits under east-central Indiana are
            permeable enough to let soil gas migrate toward foundations rather than trapping it.
          </li>
          <li>
            <strong>Older housing stock.</strong> Much of {site.city}, especially the pre-war
            neighborhoods around Ball State, sits on block foundations and unsealed crawl spaces that
            have had eighty years to develop entry points.
          </li>
          <li>
            <strong>Basements as living space.</strong> A finished basement is where radon
            concentrates and also, increasingly, where people sleep, work, and put the kids' rec
            room.
          </li>
        </ul>
      </div>

      <div>
        <div class="stat-card">
          <p class="stat-value">Zone {site.localFacts.epaZone}</p>
          <p class="stat-label">
            EPA radon zone for {site.county}, the highest-risk of the three designations
          </p>
        </div>
        <div class="stat-card">
          <p class="stat-value">{site.localFacts.avgLevel.toFixed(1)} pCi/L</p>
          <p class="stat-label">
            Average indoor level in {site.city}, identical to the EPA action level of {
              site.localFacts.epaActionLevel.toFixed(1)
            }
          </p>
        </div>
        <div class="stat-card">
          <p class="stat-value">Winter</p>
          <p class="stat-label">
            Peak season. Closed-house conditions push readings up, so a summer test can understate
            your real exposure
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. COST -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Pricing</span>
      <h2 class="mt-0">What a radon system costs in {site.city}</h2>
      <p class="section-intro">
        A typical {site.city} mitigation system runs <strong>{site.priceRange} installed</strong>.
        That is the whole answer, and we lead with it because every other radon page you'll find for
        this city makes you fill out a form to hear it.
      </p>

      <div class="cost-grid">
        <div class="card">
          <h3 class="mt-0">What the state says</h3>
          <p class="mb-0">
            Indiana's radon fact sheet puts the average system install at <strong
              >${site.localFacts.stateAvgInstallLow.toLocaleString()}–${site.localFacts.stateAvgInstallHigh.toLocaleString()}</strong
            >. That figure describes the simplest job: an accessible basement, one suction point, a
            short pipe run.
          </p>
        </div>
        <div class="card">
          <h3 class="mt-0">What quotes actually look like</h3>
          <p class="mb-0">
            Real {site.state} market pricing sits at <strong>{site.priceRange}</strong>. The gap is
            not markup. It's the jobs that need a longer route to the roofline, a second suction
            point, or crawl space membrane work.
          </p>
        </div>
        <div class="card">
          <h3 class="mt-0">What moves your number</h3>
          <ul class="mb-0">
            <li><strong>Foundation type.</strong> Slab and basement are cheapest; crawl space costs more because of the membrane labor</li>
            <li><strong>Footprint.</strong> Larger slabs may need more than one suction point</li>
            <li><strong>Fan sizing.</strong> Tighter soil needs more static pressure</li>
            <li><strong>Pipe routing.</strong> An interior route through a garage is cheaper than a long exterior run</li>
          </ul>
        </div>
      </div>

      <Callout tone="money" title="Why we publish this at all">
        <p class="mb-0">
          Pricing transparency is the entire difference between this site and the directories
          ranking above it. If our range doesn't fit your budget, you've learned that in ten seconds
          instead of after a sales visit. Full cost detail, including how crawl spaces and fan
          replacements differ, lives on the <a href="/services/radon-mitigation/">mitigation page</a>.
        </p>
      </Callout>
    </div>
  </section>

  <!-- 4. HOW IT WORKS -->
  <section class="section section-alt">
    <div class="wrap">
      <span class="eyebrow">The process</span>
      <h2 class="mt-0">How it works</h2>
      <p class="section-intro">
        Four steps from "I have no idea what my level is" to a documented system and a retest that
        proves it worked.
      </p>
      <Steps steps={steps} />
    </div>
  </section>

  <!-- 5. WHY TRUST -->
  <section class="section">
    <div class="wrap two-col">
      <div>
        <span class="eyebrow">Straight answers</span>
        <h2 class="mt-0">Why trust {site.brand}</h2>
        <p>
          Here is exactly what we are, because you should know before you call: <strong
            >{site.brand} connects {site.city} homeowners with {site.localFacts.certifier}-certified
            radon professionals.</strong
          > {site.state} requires certification from the {site.localFacts.certifierFull} to perform radon
          testing and mitigation, and the work on your house is done by someone who holds it.
        </p>
        <p>
          We're not going to claim a fleet, a founding year, or a wall of five-star reviews. What we
          offer is narrower and more useful:
        </p>
        <ul>
          <li>
            <strong>A published price range.</strong> {site.priceRange} for a typical install, on the
            page, before you talk to anyone.
          </li>
          <li>
            <strong>Free estimates.</strong> Including the ones that end with us telling you a 2.1
            pCi/L reading doesn't warrant spending $1,500 right now.
          </li>
          <li>
            <strong>{site.localFacts.certifier} certification, verified.</strong> {site.state} requires
            certification from the {site.localFacts.certifierFull} to perform radon services. We check
            it before we route anyone to you.
          </li>
          <li>
            <strong>Answers before a sales visit.</strong> Every question on this site is answered on
            this site. You should not have to book an appointment to learn what something costs.
          </li>
        </ul>
        <p>
          If you'd rather read the long version of how this works, it's on the <a href="/about/"
            >about page</a
          >.
        </p>
      </div>

      <div>
        <div class="card highlight-card">
          <h3 class="mt-0">The {site.city} market, plainly</h3>
          <p>
            Search "radon mitigation {site.city}" and you'll get Yelp, BBB, Angi, two statewide
            directories, and a national brand's auto-generated city page. The map results are mostly
            companies based in Fort Wayne and northwest Indiana.
          </p>
          <p class="mb-0">
            That's the gap this site exists to close: {site.city}-specific answers, local pricing,
            and a phone number that reaches someone who knows what {site.county} soil does.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. SERVICE AREA -->
  <section class="section section-alt">
    <div class="wrap">
      <span class="eyebrow">Coverage</span>
      <h2 class="mt-0">Serving {site.city} &amp; {site.region}</h2>
      <p class="section-intro">
        We cover {site.city} and the surrounding towns: {areaListSentence()}, plus {
          site.additionalTowns.filter((t) => t !== site.city).join(', ')
        }. Radon doesn't respect the city limit sign, and neither does {site.county}'s Zone 1
        designation.
      </p>
      <div class="area-links">
        {
          site.areas.map((area) => (
            <a href={`/service-areas/${area.slug}/`} class="area-link">
              <span class="area-name">
                Radon Mitigation in {area.name}, {site.stateAbbr}
              </span>
              <span class="area-meta">
                {area.county} · {area.driveTime} from {site.city}
              </span>
            </a>
          ))
        }
      </div>
      <p class="mb-0">
        <a href="/service-areas/">See every town we cover →</a>
      </p>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="section">
    <div class="wrap-narrow">
      <Faq items={faqs} heading="Radon questions Muncie homeowners actually ask" />
    </div>
  </section>

  <CtaBand placement="footer-cta:home" formHref="#quote" formLabel="Back to quote form" />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--s-7) var(--s-8);
    background: linear-gradient(165deg, var(--blue-50) 0%, var(--white) 62%);
    border-bottom: 1px solid var(--subtle-border);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--s-7);
    align-items: start;
  }

  .hero-copy h1 {
    margin-bottom: var(--s-4);
  }

  .hero-copy .lead {
    max-width: 54ch;
  }

  .hero-sub {
    max-width: 54ch;
    margin-bottom: var(--s-5);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
  }

  .trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .trust-row li {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--gray-700);
  }
  .trust-row :global(svg) {
    color: var(--green-700);
    flex-shrink: 0;
  }

  .section-intro {
    max-width: 70ch;
    font-size: 1.0625rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: var(--s-7);
    align-items: start;
  }

  .stat-card {
    padding: var(--s-5);
    background: var(--card-bg);
    border: 1px solid var(--subtle-border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
  }
  .stat-card + .stat-card {
    margin-top: var(--s-4);
  }
  .stat-value {
    margin: 0 0 var(--s-2);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--navy-800);
  }
  .stat-label {
    margin: 0;
    font-size: 0.9375rem;
  }

  .cost-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: var(--s-4);
    margin-block: var(--s-5);
  }
  .cost-grid h3 {
    font-size: 1.0625rem;
  }
  .cost-grid p,
  .cost-grid ul {
    font-size: 0.9375rem;
  }

  .highlight-card {
    background: var(--navy-800);
    border-color: var(--navy-800);
    color: rgba(255, 255, 255, 0.82);
  }
  .highlight-card h3 {
    color: var(--white);
  }

  .area-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--s-3);
    margin-block: var(--s-5);
  }
  .area-link {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-4);
    background: var(--card-bg);
    border: 1px solid var(--subtle-border);
    border-radius: var(--r-md);
    text-decoration: none;
  }
  .area-link:hover {
    border-color: var(--blue-500);
    background: var(--blue-50);
  }
  .area-name {
    font-weight: 650;
    color: var(--link);
  }
  .area-meta {
    font-size: 0.8125rem;
    color: var(--muted-text);
  }

  @media (max-width: 980px) {
    .hero-grid,
    .two-col {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
  }

  @media (max-width: 520px) {
    .hero-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
