---
import { site } from '../site.config';
import PhoneLink from './PhoneLink.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));
---

<header class="site-header">
  <div class="wrap header-inner">
    <!-- No aria-label. The link's own text already names it, and an aria-label
         that omits the visible tagline fails label-content-name-mismatch. -->
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true">
        <Logo size={26} />
      </span>
      <span class="brand-text">
        <strong>{site.brand}</strong>
        <small>{site.headerTagline}</small>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-cta">
      <PhoneLink placement="header" variant="button" />
    </div>
  </div>

  <!-- Mobile: horizontally scrollable strip instead of a hamburger. No JS,
       and every destination stays one tap away. -->
  <nav class="mobile-nav" aria-label="Primary mobile">
    <ul>
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    border-bottom: 1px solid var(--subtle-border);
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    min-height: var(--header-h);
    padding-block: var(--s-2);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    color: var(--primary-text);
    margin-right: auto;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: var(--r-md);
    background: var(--navy-800);
    color: var(--white);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .brand-text strong {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .brand-text small {
    font-size: 0.75rem;
    color: var(--muted-text);
  }

  .site-nav ul {
    display: flex;
    gap: var(--s-5);
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .site-nav li {
    margin: 0;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--gray-700);
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--blue-600);
  }
  .site-nav a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--blue-600);
  }

  .mobile-nav {
    display: none;
    border-top: 1px solid var(--subtle-border);
    background: var(--gray-100);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .mobile-nav::-webkit-scrollbar {
    display: none;
  }
  .mobile-nav ul {
    display: flex;
    gap: var(--s-4);
    list-style: none;
    margin: 0;
    padding: 0 var(--s-5);
    max-width: none;
    white-space: nowrap;
  }
  .mobile-nav li {
    margin: 0;
  }
  .mobile-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--gray-700);
    text-decoration: none;
  }
  .mobile-nav a[aria-current='page'] {
    color: var(--blue-600);
    box-shadow: inset 0 -2px 0 var(--blue-600);
  }

  /* Below the desktop breakpoint the nav collapses and the call button stays.
     A phone call is the conversion, so it never hides behind a hamburger. */
  @media (max-width: 940px) {
    .site-nav {
      display: none;
    }
    .brand-text small {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
  }

  @media (max-width: 420px) {
    .header-inner {
      gap: var(--s-3);
    }
    .header-cta :global(.btn) {
      padding-inline: var(--s-4);
      font-size: 1rem;
    }
  }
</style>
