---
/**
 * Working vs failed manometer, side by side.
 *
 * This is the highest-value diagram on the site and the one nobody else has.
 * A dead radon fan produces no symptom whatsoever, so the manometer is the only
 * indicator a homeowner has, and "uneven means working" is genuinely hard to
 * convey in a sentence. Two pictures settle it in a second.
 */
import Diagram from './Diagram.astro';

const steps = [
  {
    n: 1,
    label: 'Working.',
    body: 'The liquid sits at <strong>different heights</strong> in the two columns. That offset is the suction your fan is pulling. Photograph it now, while the system is known-good, so you have a baseline.',
  },
  {
    n: 2,
    label: 'Not working.',
    body: 'The two columns are <strong>level with each other</strong>. The fan is not moving air, and the house has been refilling with radon since it quit. See <a href="/services/system-repair/">system repair</a>.',
  },
];
---

<Diagram
  title="Reading your manometer"
  alt="Two manometer gauges compared. On the working system the liquid sits at two different heights; on the failed system both columns are level with each other."
  steps={steps}
  caption="Check it once a season. It takes five seconds and it is the only warning you will ever get."
>
  <svg viewBox="0 0 420 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <!-- WORKING -->
    <g transform="translate(56 24)">
      <rect x="0" y="0" width="120" height="140" rx="10" fill="#ffffff" stroke="#41505f"
        stroke-width="2.5" />
      <!-- U-tube -->
      <path d="M38 22 V96 a22 22 0 0 0 44 0 V22" fill="none" stroke="#cdd6df" stroke-width="13"
        stroke-linecap="round" />
      <!-- Liquid: offset columns. Left column low, right column high. -->
      <path d="M38 74 V96 a22 22 0 0 0 44 0 V44" fill="none" stroke="#14663f" stroke-width="9"
        stroke-linecap="round" />
      <!-- Offset bracket -->
      <g stroke="#14663f" stroke-width="1.6" opacity="0.8">
        <line x1="94" y1="44" x2="108" y2="44" stroke-dasharray="3 2" />
        <line x1="94" y1="74" x2="108" y2="74" stroke-dasharray="3 2" />
        <line x1="103" y1="44" x2="103" y2="74" />
        <path d="M100 48 L103 44 L106 48" fill="none" />
        <path d="M100 70 L103 74 L106 70" fill="none" />
      </g>
      <circle cx="60" cy="130" r="11" fill="#14663f" />
      <path d="M55 130 L59 134 L66 126" fill="none" stroke="#fff" stroke-width="2.4"
        stroke-linecap="round" stroke-linejoin="round" />
    </g>

    <!-- FAILED -->
    <g transform="translate(244 24)">
      <rect x="0" y="0" width="120" height="140" rx="10" fill="#ffffff" stroke="#41505f"
        stroke-width="2.5" />
      <path d="M38 22 V96 a22 22 0 0 0 44 0 V22" fill="none" stroke="#cdd6df" stroke-width="13"
        stroke-linecap="round" />
      <!-- Liquid: both columns at the same height. -->
      <path d="M38 60 V96 a22 22 0 0 0 44 0 V60" fill="none" stroke="#a32020" stroke-width="9"
        stroke-linecap="round" />
      <!-- Level indicator -->
      <line x1="26" y1="60" x2="94" y2="60" stroke="#a32020" stroke-width="1.6"
        stroke-dasharray="4 3" opacity="0.9" />
      <circle cx="60" cy="130" r="11" fill="#a32020" />
      <path d="M56 126 L64 134 M64 126 L56 134" fill="none" stroke="#fff" stroke-width="2.4"
        stroke-linecap="round" />
    </g>

    <!-- Numbered markers -->
    <g font-family="system-ui, sans-serif" font-size="12" font-weight="700" text-anchor="middle">
      <circle cx="34" cy="34" r="11" fill="#0d1f31" /><text x="34" y="38" fill="#fff">1</text>
      <circle cx="386" cy="34" r="11" fill="#0d1f31" /><text x="386" y="38" fill="#fff">2</text>
    </g>
  </svg>
</Diagram>
