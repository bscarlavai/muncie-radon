---
import '../styles/global.css';
import { site } from '../site.config';
import { siteGraph } from '../lib/schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  /** <title>: write it for the SERP, not for the page */
  title: string;
  description: string;
  /** Defaults to the current path */
  canonical?: string;
  noindex?: boolean;
  /** Page-specific JSON-LD appended after the sitewide graph */
  schema?: unknown[];
  bodyClass?: string;
}

const { title, description, canonical, noindex = false, schema = [], bodyClass } = Astro.props;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-default.png', Astro.site).href;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    {/*
      Declaring the dimensions lets a scraper lay the card out before it has
      finished downloading the image, which is the difference between a rich
      preview and a bare URL when a fetcher gives up early. Keep these in sync
      with scripts/gen-icons.mjs, which renders og-default.png at 1200x630.
    */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.brand}: radon testing and mitigation in ${site.city}, ${site.stateAbbr}`} />
    <meta property="og:locale" content="en_US" />
    {/* summary_large_image without an explicit twitter:image relies on the og:image
        fallback. It works, but being explicit costs one tag and removes the guess. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#12293f" />
    <meta name="geo.region" content={`US-${site.stateAbbr}`} />
    <meta name="geo.placename" content={site.city} />

    {/*
      Both, in this order, on purpose. A browser that understands SVG picks the
      scalable one; everything else, plus the audit tools and link unfurlers that
      request /favicon.ico at the root regardless of markup, gets the .ico.
    */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <JsonLd data={siteGraph()} />
    {schema.map((node) => <JsonLd data={node} />)}

    {
      site.analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${site.analyticsToken}"}`}
        />
      )
    }
  </head>

  <body class={bodyClass}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
